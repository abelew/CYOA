## Write out the various arguments here to see what happened:
## exe: [% trimomatic_exe %]
## quality: [% phred_flags %]
## adapter_file: [% adapter_file %]
## file descriptor: [% input_string %]
## output: [% main %]
## leader: [% leader_flags %]
## adapter: [% adapter_flags %]
## window: [% window_flags %]
## length [% length_flags %]
## stdout: [% stdout %]
## stderr: [% stderr %]

/usr/bin/time -v -o [% time_file %] -a \
  [% trimomatic_exe %] [%= thread_flags =%] [%= phred_flags =%] \
  [% input_string %] [%= output_r1 =%] \
  [% adapter_flags %] [%= leader_flags =%] [%= window_flags =%] [%= length_flags =%] [%= suffix_flags =%] \
  1>[% stdout %] \
  2>[% stderr %]
excepted=$( { grep "Exception" "[% stdout %]" || test $? = 1; } )
## The following is in case the illumina clipping fails, which it does if this has already been run I think.
if [[ "${excepted}" != "" ]]; then
  /usr/bin/time -v -o [% time_file %] -a \
    [% trimomatic_exe %] [%= thread_flags =%] [%= phred_flags =%] \
    [% input_string %] [%= output_r1 =%] \
    [% adapter_flags %] [% leader_flags %] [%= window_flags =%] [% length_flags %] [%= suffix_flags =%] \
    1>[% stdout %] \
    2>[% stderr %]
fi

[% compress_string %]
