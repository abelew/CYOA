## Write out the various arguments here to see what happened:
## output: [% main %]
## metrics: [% metrics %]
## discordant aligned: [% aligned_discodant %]
## discordant unaligned: [% unaligned_discordant %]
## input string: [% input_string %]
## samtools: [% samtools %]
## json_out: [% json_flags %]
## extra: [% extra_flags %]
## stdout: [% stdout %]
## stderr: [% stderr %]

## Invoke hisat2 on some (presumably) trimmed reads.
## FIXME: Make sure the arbitrary flags are ready to be used.
/usr/bin/time -v -o [% time_file %] -a \
  salmon quant -i [% index_shell %] \
    -l [% strand_string %] --gcBias --validateMappings \
    [% sa_args %] \
    -o [% output_dir %] \
    2>[% stderr %] 1>[% stdout %]
