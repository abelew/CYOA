[% perl_shebang %]
use strict;
use Modern::Perl;
use FileHandle;
use Bio::Adventure;
my $out = FileHandle->new(">>[% log %]");
my $d = qx'date';
print $out "### Started [% jname %] at ${d}.\n";
chdir("[% basedir %]");
my $h = Bio::Adventure->new();
[% IF prescript %][% prescript %]
[% END -%]

[% perl_jstring %]

[% IF postscript %][% postscript %]
[% END -%]
## The following lines provide status codes and some logging.
my $jobid = q{};
$jobid = $ENV{SLURM_JOBID} if ($ENV{SLURM_JOBID});
my $end_d = qx'date';
print $out qq"### Finished ${jobid} [% jname %] at ${end_d}.\n";
$out->close();
